{
  "type": "json_schema",
  "json_schema": {
    "name": "legal_reasoning_causality_response",
    "strict": true,
    "schema": {
      "type": "object",
      "properties": {
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Text": {
                "type": "string",
                "description": "Excerpt from a US Federal District Court opinion."
              },
              "Answer": {
                "type": "string",
                "enum": ["Yes", "No"],
                "description": "Whether the reasoning relies on statistical evidence."
              }
            },
            "required": ["Text", "Answer"],
            "additionalProperties": false
          }
        }
      },
      "required": ["pairs"],
      "additionalProperties": false
    }
  }
}