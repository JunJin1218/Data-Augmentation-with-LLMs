{
    "format": {
        "type": "json_schema",
        "name": "wsc_synthetic_data",
        "strict": true,
        "schema": {
            "type": "object",
            "properties": {
                "pairs": {
                    "type": "array",
                    "description": "A list of WSC-style instances.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "text": { "type": "string", "description": "The full sentence." },
                            "span1_text": { "type": "string", "description": "The ambiguous pronoun." },
                            "span2_text": { "type": "string", "description": "The candidate antecedent." },
                            "label": { "type": "number", "enum": [0, 1], "description": "1 if Span1Text refers to Span2Text, else 0." }
                        },
                        "required": ["text", "span1_text", "span2_text", "label"],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["pairs"],
            "additionalProperties": false
        }
    }
}