{
    "format": {
        "type": "json_schema",
        "name": "wic_synthetic_data",
        "strict": true,
        "schema": {
            "type": "object",
            "properties": {
                "pairs": {
                    "type": "array",
                    "description": "A list of WiC-style instances.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "word": { "type": "string", "description": "Target word/lemma present in both sentences." },
                            "sentence1": { "type": "string", "description": "First sentence containing the target word." },
                            "sentence2": { "type": "string", "description": "Second sentence containing the target word." },
                            "label": { "type": "number", "description": "1 if same meaning, 0 if different meaning." },
                            "start1": {
                                "type": "number",
                                "description": "Start character index of the target word in Sentence1."
                            },
                            "end1": {
                                "type": "number",
                                "description": "End character index of the target word in Sentence1."
                            },
                            "start2": {
                                "type": "number",
                                "description": "Start character index of the target word in Sentence2."
                            },
                            "end2": {
                                "type": "number",
                                "description": "End character index of the target word in Sentence2."
                            }
                        },
                        "required": ["word", "sentence1", "sentence2", "label", "start1", "start2", "end1", "end2"],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["pairs"],
            "additionalProperties": false
        }
    }
}