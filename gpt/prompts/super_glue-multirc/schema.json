{
    "format": {
        "type": "json_schema",
        "name": "multirc_synthetic_data",
        "strict": true,
        "schema": {
            "type": "object",
            "properties": {
                "pairs": {
                    "type": "array",
                    "description": "A list of flattened MultiRC-style instances.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "paragraph": {
                                "type": "string",
                                "description": "The passage text associated with this question-answer pair."
                            },
                            "question": {
                                "type": "string",
                                "description": "The question about the passage."
                            },
                            "answer": {
                                "type": "string",
                                "description": "A candidate answer for this question."
                            },
                            "label": {
                                "type": "number",
                                "enum": [0, 1],
                                "description": "1 if this answer is correct for the question, 0 otherwise."
                            }
                        },
                        "required": ["paragraph", "question", "answer", "label"],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["pairs"],
            "additionalProperties": false
        }
    }
}